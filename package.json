{
  "name": "@supersemantics/vsl-core",
  "version": "0.2.2",
  "description": "Framework-agnostic and model-agnostic VSL (VERBA Specification Language) governance primitives -- TypeScript port of vsl-core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supersemantics/VSL-Corejs.git"
  },
  "homepage": "https://github.com/supersemantics/VSL-Corejs#readme",
  "bugs": {
    "url": "https://github.com/supersemantics/VSL-Corejs/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs-dist.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "governance",
    "ai-safety",
    "guardrails",
    "audit-log",
    "vsl",
    "verba"
  ],
  "publishConfig": {
    "access": "public"
  }
}
